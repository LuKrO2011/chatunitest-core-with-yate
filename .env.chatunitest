# Yate (.env.chatunitest) configuration template.
#
# This file was previously hard-coded to an absolute path on the original author's machine
# (see YateConfig.java). It is now resolved via the CHATUNITEST_YATE_ENV environment variable,
# the chatunitest.yate.env system property, or this file in the working directory.
#
# Fill in the values below to match your LLM endpoint. The Defects4J driver
# (zju.cst.aces.driver.Defects4jDriver) reads LLM_BASE_URL / LLM_API_KEY / LLM_MODEL from the
# process environment for ChatUniTest generation; Yate repair reads its own settings from here.

# OpenAI-compatible endpoint used by Yate for the repair conversation.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=changeme
LLM_MODEL=gpt-4o-mini

# Sampling temperature for Yate repair (the ChatUniTest generation side is pinned to 0.1 by the driver).
LLM_TEMPERATURE=0.1

# Optional: directory Yate writes intermediate artefacts to (defaults to a temp dir when unset).
# YATE_OUTPUT_DIR=/tmp/yate-output
